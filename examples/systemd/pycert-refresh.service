[Unit]
Description=Poll pending pyCert certificate requests
Documentation=file:///usr/local/share/doc/pycert/README.md

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pycert -q --config %h/.config/pycert/pycert.toml status --refresh
# The saved passphrase must be available to the service. With the
# secret-service backend, run the timer as the logged-in user; with the env
# backend, add: Environment=PYCERT_P12_PASSPHRASE=...
